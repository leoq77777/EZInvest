# ──────────────────────────────────────────────
# LLM Server (choose ONE backend)
# ──────────────────────────────────────────────
# Agent 使用 LLM_PROVIDER 决定连哪套接口（见 backend/app/agent/llm.py）。
# 仅填 DEEPSEEK_API_KEY 而不设 LLM_PROVIDER=deepseek 时，以前会仍连 Ollama — 已修复。
# LLM_PROVIDER=local | openai | deepseek
LLM_PROVIDER=local

# Option A: vLLM (recommended, GPU required)
#   Start:  python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B --port 8000
#   Or:     docker compose --profile vllm up
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_PATH=Qwen/Qwen2.5-7B
LLM_API_KEY=not-needed
# 单次 LLM HTTP 读超时（秒，后端 LLM_TIMEOUT_SEC）
LLM_TIMEOUT_SEC=180

# Option B: Ollama (easiest, CPU or GPU)
#   Start:  ollama pull qwen2.5:7b && ollama serve
#   Or:     docker compose --profile ollama up
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_PATH=qwen2.5:7b
# LLM_API_KEY=ollama

# Option C: llama.cpp (CPU-friendly, GGUF format)
#   Start:  ./scripts/serve_model.sh llamacpp models/qwen2.5-7b.Q4_K_M.gguf
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_PATH=models/qwen2.5-7b.Q4_K_M.gguf
# LLM_API_KEY=not-needed

# ──────────────────────────────────────────────
# FinBERT
# ──────────────────────────────────────────────
# Use HuggingFace ID (auto-downloads) or local path after fine-tuning
FINBERT_MODEL_PATH=ProsusAI/finbert
# FINBERT_MODEL_PATH=models/finetuned/finbert-sentiment

# ──────────────────────────────────────────────
# Embedding & Reranker (LOCAL HuggingFace — NOT your chat LLM API key)
# ──────────────────────────────────────────────
# Chat uses LLM_* / OPENAI_* / DEEPSEEK_* above. RAG uses sentence-transformers on
# this machine: first run downloads weights, then they stay in HF cache
# (HF_HOME or ~/.cache/huggingface), same as any other HF model id.
#
# Repo 自带的 FAISS 索引是 bge-large 1024 维；若改 EMBEDDING_MODEL 为小模型，请重建索引，
# 否则稠密检索会自动跳过（仍可用 BM25）。
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 交叉编码精排会再加载一整份 reranker 模型；本地开发建议 false，需要检索质量再开 true
ENABLE_RAG_RERANKER=false

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ezinvest:ezinvest@localhost:5432/ezinvest
# 连不上 5432 / connection refused：本机要先起数据库。仓库根目录执行其一：
#   docker compose up -d postgres redis
#   或装本地 Postgres 并创建库/用户与上面 URL 一致。
# 若暂时不想用库：ENABLE_PERSISTENCE=false（无会话持久化 / pgvector 动态检索）
ENABLE_PERSISTENCE=true

# ──────────────────────────────────────────────
# 三层记忆（会话摘录 / 顾问风格 / RAG 核心）
# ──────────────────────────────────────────────
# RAG 每轮检索条数（HybridRetriever → system 的「核心决策知识库」）
RAG_CORE_TOP_K=8
# 当前会话注入模型的最近消息条数（Layer 1）
SESSION_CONTEXT_MESSAGES=16
# 默认顾问风格 Markdown（Layer 2）；也可写入表 profile_agent_styles 按 profile 覆盖
# AGENT_STYLE_MARKDOWN=- 语气：专业、克制，多用条目与数据来源标注。

# 非当前会话定期摘要 → conversation_summaries + pgvector（Layer 3 语料）
# 生产环境可设为 true，以启用周期性跨会话摘要
ENABLE_SESSION_SUMMARY_JOB=false
SESSION_SUMMARY_INTERVAL_SEC=900
SESSION_SUMMARY_STARTUP_DELAY_SEC=45
MIN_MESSAGES_TO_SUMMARIZE_SESSION=6

# ──────────────────────────────────────────────
# FAISS
# ──────────────────────────────────────────────
FAISS_INDEX_PATH=data/indexes/faiss_hnsw.index
BM25_INDEX_PATH=data/indexes/bm25.pkl

# ──────────────────────────────────────────────
# Market Data
# ──────────────────────────────────────────────
MARKET_DATA_API_KEY=your-api-key-here
MARKET_DATA_PROVIDER=yfinance

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO
# true = 所有流式请求默认附带 debug SSE（与请求体 debug_stream、前端 NEXT_PUBLIC_STREAM_DEBUG 为 OR）
DEBUG_STREAM=false
# 流式 SSE：在等待 RAG / Agent 时定期发送注释行，避免 Next/代理因 TCP 空闲掐断（秒；0=关闭）
# SSE_KEEPALIVE_INTERVAL_SEC=5
# 含 127.0.0.1 / 3001 便于本机多端口调试；生产请收紧为你的前端域名
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# 前端：开发时建议不要设置 NEXT_PUBLIC_API_URL，让浏览器请求同源 /api，由 Next rewrites 转到本后端，避免 CORS。
# 若必须直连后端再设置，例如：NEXT_PUBLIC_API_URL=http://localhost:8080
#
# ── 前端启动时行为（勿在聊天 UI 勾选；写入 frontend/.env.local 或启动命令行 export）──
# NEXT_PUBLIC_STREAM_DEBUG=1          # SSE debug 阶段 + 助手消息内「后端诊断」区
# NEXT_PUBLIC_SAVE_USER_MESSAGE_AS_MEMORY=1   # 每轮默认把用户消息写入长期记忆（仍走后端 save_message_as_memory）
# NEXT_PUBLIC_CONVERSATION_DB=off       # 不调会话 bootstrap，无侧边历史（纯浏览器态）
#
# 流式整流（frontend）：区分「一直连不上」vs「连上但长时间无新包」vs「总时间过长」
# NEXT_PUBLIC_STREAM_CHUNK_IDLE_MS=120000
# NEXT_PUBLIC_STREAM_TOTAL_MS=600000

# HuggingFace token (for gated models)
# HF_TOKEN=hf_xxx
