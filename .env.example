# ──────────────────────────────────────────────
# LLM Server (choose ONE backend)
# ──────────────────────────────────────────────

# Option A: vLLM (recommended, GPU required)
#   Start:  python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B --port 8000
#   Or:     docker compose --profile vllm up
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_PATH=Qwen/Qwen2.5-7B
LLM_API_KEY=not-needed

# Option B: Ollama (easiest, CPU or GPU)
#   Start:  ollama pull qwen2.5:7b && ollama serve
#   Or:     docker compose --profile ollama up
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_PATH=qwen2.5:7b
# LLM_API_KEY=ollama

# Option C: llama.cpp (CPU-friendly, GGUF format)
#   Start:  ./scripts/serve_model.sh llamacpp models/qwen2.5-7b.Q4_K_M.gguf
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_PATH=models/qwen2.5-7b.Q4_K_M.gguf
# LLM_API_KEY=not-needed

# ──────────────────────────────────────────────
# FinBERT
# ──────────────────────────────────────────────
# Use HuggingFace ID (auto-downloads) or local path after fine-tuning
FINBERT_MODEL_PATH=ProsusAI/finbert
# FINBERT_MODEL_PATH=models/finetuned/finbert-sentiment

# ──────────────────────────────────────────────
# Embedding & Reranker
# ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ezinvest:ezinvest@localhost:5432/ezinvest

# ──────────────────────────────────────────────
# FAISS
# ──────────────────────────────────────────────
FAISS_INDEX_PATH=data/indexes/faiss_hnsw.index
BM25_INDEX_PATH=data/indexes/bm25.pkl

# ──────────────────────────────────────────────
# Market Data
# ──────────────────────────────────────────────
MARKET_DATA_API_KEY=your-api-key-here
MARKET_DATA_PROVIDER=yfinance

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# HuggingFace token (for gated models)
# HF_TOKEN=hf_xxx
